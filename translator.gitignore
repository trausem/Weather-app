# -*- coding: utf-8 -*-
from mss import mss
import easyocr
import tkinter as tk
from google import genai
import threading
import time
import numpy as np
import sys
import io
import os
from PIL import Image

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')

MODEL_ID = "gemini-2.0-flash"

api_key = os.getenv("GEMINI_API_KEY")
if not api_key:
    raise RuntimeError("Brak zmiennej środowiskowej GEMINI_API_KEY")

client = genai.Client(api_key=api_key)

print("Ładowanie OCR (to może potrwać)...")
reader = easyocr.Reader(['en', 'pl'], gpu=False)


class OverlayApp:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Tłumacz Gemini")
        self.root.attributes("-topmost", True)
        self.root.attributes("-alpha", 0.85)
        self.root.geometry("900x120+500+800")
        self.root.overrideredirect(True)

        self.label = tk.Label(
            self.root,
            text="Gotowy. Czekam na tekst...",
            fg="white",
            bg="#1c1c1c",
            font=("Arial", 14, "bold"),
            wraplength=850,
            justify="left"
        )
        self.label.pack(expand=True, fill="both")

        self.label.bind("<B1-Motion>", self.move_window)
        self.label.bind("<Button-3>", self.safe_exit)

        self.running = True
        self.thread = threading.Thread(target=self.loop_capture, daemon=True)
        self.thread.start()

    def safe_exit(self, event=None):
        self.running = False
        self.root.destroy()

    def move_window(self, event):
        self.root.geometry(f"+{event.x_root}+{event.y_root}")

    def update_text(self, new_text):
        if self.root.winfo_exists():
            self.root.after(0, lambda: self.label.config(text=new_text))

    def loop_capture(self):
        with mss() as sct:
            monitor = {"top": 700, "left": 300, "width": 1200, "height": 300}
            last_text = ""

            while self.running:
                try:
                    sct_img = sct.grab(monitor)
                    img = Image.frombytes("RGB", sct_img.size, sct_img.bgra, "raw", "BGRX")

                    result = reader.readtext(
                        np.array(img),
                        detail=0,
                        paragraph=True,
                        min_size=10
                    )
                    full_text = " ".join(result).strip()

                    if "import " in full_text or "def " in full_text or len(full_text) < 5:
                        time.sleep(1.5)
                        continue

                    if full_text != last_text:
                        prompt = f"Przetłumacz na polski, zwięźle i naturalnie: {full_text}"
                        response = client.models.generate_content(
                            model=MODEL_ID,
                            contents=prompt
                        )

                        if getattr(response, "text", None):
                            self.update_text(response.text.strip())
                            last_text = full_text
                            print("Przetłumaczono OK")

                        time.sleep(4)

                    else:
                        time.sleep(1)

                except Exception as e:
                    err = str(e)
                    print(f"Błąd: {err}")

                    if "429" in err:
                        self.update_text("Limit API wyczerpany. Czekam 30 s...")
                        time.sleep(30)
                    else:
                        self.update_text(f"Błąd: {err[:120]}")
                        time.sleep(2)


if __name__ == "__main__":
    app = OverlayApp()
    app.root.mainloop()